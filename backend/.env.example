# Copy this file to .env and adjust as needed.

# Postgres connection string. The docker-compose.yml service below matches these defaults.
# Two things about this URL are deliberate, both to dodge conflicts with anything else already
# running on your machine (very common on Windows, e.g. a natively-installed Postgres from another
# project):
#   1. 127.0.0.1 instead of "localhost" - avoids "localhost" resolving to the IPv6 loopback (::1)
#      first and silently hitting a different service also listening on IPv6.
#   2. Host port 5433 instead of Postgres's default 5432 - avoids colliding with another process
#      already bound to 5432. This is only the HOST-side port; the container's internal port is
#      still 5432 (see docker-compose.yml), so `docker exec` commands are unaffected.
DATABASE_URL="postgresql://report_app:report_app_password@127.0.0.1:5433/weekly_reports?schema=public"

# A second database is used while running the automated test suite, so tests never touch your dev data.
# Create it once with: docker exec -it weekly-reports-postgres psql -U report_app -d weekly_reports -c "CREATE DATABASE weekly_reports_test OWNER report_app;"
TEST_DATABASE_URL="postgresql://report_app:report_app_password@127.0.0.1:5433/weekly_reports_test?schema=public"

# JWT secrets - change these to long random strings for anything beyond local dev.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (your frontend's dev/prod URL(s))
CORS_ORIGIN="http://localhost:3000"
